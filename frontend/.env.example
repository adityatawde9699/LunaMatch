# Copy to frontend/.env.local for local Vite development.
# Leave empty to use the Vite /api proxy to http://127.0.0.1:8000.
VITE_API_BASE_URL=

# On Vercel, set VITE_API_BASE_URL in Project Settings instead, for example:
# VITE_API_BASE_URL=https://your-api.onrender.com
# Use the API origin only; do not append /api or /api/v1.
