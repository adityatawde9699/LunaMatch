# LunaMatch API and CLI configuration for local development.
# Copy to .env, then export these values in your shell before starting Uvicorn.
# The Python application does not load .env files automatically.
# On Render, enter these values in the service's Environment settings instead.

LUNAMATCH_RESULTS_DIR=results/jobs
LUNAMATCH_MODEL_CACHE=results/model-cache
LUNAMATCH_MAX_UPLOAD_BYTES=104857600
LUNAMATCH_MAX_CONCURRENT_JOBS=1
LUNAMATCH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LUNAMATCH_DESCRIPTOR_DEVICE=auto

# Optional: uncomment only after creating or provisioning a real checkpoint.
# LUNAMATCH_DESCRIPTOR_CHECKPOINT=results/learned/lunar_patch_descriptor.pt
